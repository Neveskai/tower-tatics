rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de torres e missões: leitura pública (app carrega antes do login)
    match /catalog_towers/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /catalog_missions/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Dados do usuário: só o dono pode ler/escrever
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
